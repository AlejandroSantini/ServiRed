# Copiar a .env y completar. NUNCA subir .env al repositorio.

NODE_ENV=development
PUERTO=3000

# memoria (sin base, para desarrollar) | postgres
PERSISTENCIA=postgres
DATABASE_URL=postgres://servired:servired@localhost:5432/servired

ORIGEN_FRONTEND=http://localhost:5173
SESION_MINUTOS=60

# Claves de 32 bytes en base64. Generarlas con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierden CLAVE_CIFRADO o CLAVE_INTEGRIDAD, los datos cifrados y los dígitos verificadores dejan de ser válidos.
CLAVE_TOKEN=
CLAVE_CIFRADO=
CLAVE_INTEGRIDAD=

# Primer administrador (lo crea npm run db:inicializar)
ADMIN_EMAIL=admin@servired.com.ar
ADMIN_CONTRASENA=

# HTTPS (RNF03): certificado propio, o bien un proxy HTTPS delante (nginx, Render, Railway)
TLS_CERT=
TLS_KEY=
DETRAS_DE_PROXY_HTTPS=false

# Backups (requiere pg_dump y pg_restore instalados)
DIRECTORIO_BACKUPS=./backups
PG_DUMP=pg_dump
PG_RESTORE=pg_restore
